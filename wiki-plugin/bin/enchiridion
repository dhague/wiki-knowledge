#!/bin/sh
# The one entrypoint every skill and hook calls, e.g.
#   "${CLAUDE_PLUGIN_ROOT}/bin/enchiridion" search "<terms>" --json
#
# A POSIX-sh shim that execs `node` against the esbuild bundle (ADR-0017),
# forwarding every argument untouched. `ENCHIRIDION_BIN` runs an executable
# as-is instead, for development against unbundled source or another runtime.

set -eu

plugin_root=$(unset CDPATH; cd -- "$(dirname -- "$0")/.." && pwd)

if [ -n "${ENCHIRIDION_BIN:-}" ]; then
    exec "$ENCHIRIDION_BIN" "$@"
fi

# Artifact resolution order: in-plugin $plugin_root/scripts/cli.cjs (the
# shipped bundle a marketplace install sees) wins over the sibling dev build
# at ../enchiridion-ts/dist/cli.cjs.
if [ -f "$plugin_root/scripts/cli.cjs" ]; then
    bundle="$plugin_root/scripts/cli.cjs"
else
    bundle="$plugin_root/../enchiridion-ts/dist/cli.cjs"
fi

exec node "$bundle" "$@"
